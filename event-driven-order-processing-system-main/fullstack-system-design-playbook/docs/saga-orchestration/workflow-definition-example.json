{
  "name": "minishop_checkout_saga_conceitual",
  "description": "Conceptual educational example inspired by Netflix Conductor. This file should not be submitted to a real Conductor server without adaptation.",
  "version": 1,
  "schemaVersion": 2,
  "ownerEmail": "architecture@minishop.local",
  "restartable": true,
  "workflowStatusListenerEnabled": true,
  "timeoutPolicy": "TIME_OUT_WF",
  "timeoutSeconds": 3600,
  "inputParameters": [
    "orderId",
    "customerId",
    "cartId",
    "paymentMethodId",
    "correlationId",
    "idempotencyKey"
  ],
  "variables": {
    "documentationOnly": true,
    "runtime": "mock"
  },
  "tasks": [
    {
      "name": "criar_pedido_pendente",
      "taskReferenceName": "criar_pedido_pendente",
      "type": "SIMPLE",
      "description": "Creates the order in a pending state using an idempotent local operation.",
      "inputParameters": {
        "orderId": "${workflow.input.orderId}",
        "customerId": "${workflow.input.customerId}",
        "cartId": "${workflow.input.cartId}",
        "correlationId": "${workflow.input.correlationId}",
        "idempotencyKey": "${workflow.input.idempotencyKey}"
      },
      "retryCount": 2,
      "retryDelaySeconds": 2,
      "timeoutSeconds": 30
    },
    {
      "name": "autorizar_pagamento",
      "taskReferenceName": "autorizar_pagamento",
      "type": "SIMPLE",
      "description": "Authorizes payment at the gateway using an external idempotency key.",
      "inputParameters": {
        "orderId": "${workflow.input.orderId}",
        "paymentMethodId": "${workflow.input.paymentMethodId}",
        "correlationId": "${workflow.input.correlationId}",
        "idempotencyKey": "${workflow.input.idempotencyKey}"
      },
      "retryCount": 3,
      "retryDelaySeconds": 5,
      "timeoutSeconds": 45
    },
    {
      "name": "decidir_resultado_pagamento",
      "taskReferenceName": "decidir_resultado_pagamento",
      "type": "SWITCH",
      "description": "Decides whether the flow continues, checks the gateway, or cancels the order.",
      "evaluatorType": "value-param",
      "expression": "paymentStatus",
      "inputParameters": {
        "paymentStatus": "${autorizar_pagamento.output.status}"
      },
      "decisionCases": {
        "CONFIRMADO": [
          {
            "name": "reservar_estoque",
            "taskReferenceName": "reservar_estoque",
            "type": "SIMPLE",
            "description": "Reserves inventory idempotently for the order.",
            "inputParameters": {
              "orderId": "${workflow.input.orderId}",
              "cartId": "${workflow.input.cartId}",
              "correlationId": "${workflow.input.correlationId}"
            },
            "retryCount": 3,
            "retryDelaySeconds": 3,
            "timeoutSeconds": 30
          },
          {
            "name": "confirmar_pedido",
            "taskReferenceName": "confirmar_pedido",
            "type": "SIMPLE",
            "description": "Confirms the order after payment and inventory reservation.",
            "inputParameters": {
              "orderId": "${workflow.input.orderId}",
              "correlationId": "${workflow.input.correlationId}"
            },
            "retryCount": 2,
            "retryDelaySeconds": 2,
            "timeoutSeconds": 30
          },
          {
            "name": "decidir_confirmacao_pedido",
            "taskReferenceName": "decidir_confirmacao_pedido",
            "type": "SWITCH",
            "description": "Applies compensation if order confirmation fails after payment authorization.",
            "evaluatorType": "value-param",
            "expression": "orderConfirmationStatus",
            "inputParameters": {
              "orderConfirmationStatus": "${confirmar_pedido.output.status}"
            },
            "decisionCases": {
              "CONFIRMADO": [
                {
                  "name": "publicar_pedido_confirmado",
                  "taskReferenceName": "publicar_pedido_confirmado",
                  "type": "SIMPLE",
                  "description": "Publishes an order confirmation event through the outbox.",
                  "inputParameters": {
                    "orderId": "${workflow.input.orderId}",
                    "eventType": "PedidoConfirmado",
                    "correlationId": "${workflow.input.correlationId}"
                  },
                  "retryCount": 5,
                  "retryDelaySeconds": 10,
                  "timeoutSeconds": 60
                }
              ],
              "FALHOU": [
                {
                  "name": "reembolsar_pagamento",
                  "taskReferenceName": "reembolsar_pagamento",
                  "type": "SIMPLE",
                  "description": "Compensates an authorized payment when the order cannot be confirmed.",
                  "inputParameters": {
                    "orderId": "${workflow.input.orderId}",
                    "paymentReference": "${autorizar_pagamento.output.paymentReference}",
                    "correlationId": "${workflow.input.correlationId}"
                  },
                  "retryCount": 3,
                  "retryDelaySeconds": 10,
                  "timeoutSeconds": 60
                },
                {
                  "name": "cancelar_pedido",
                  "taskReferenceName": "cancelar_pedido",
                  "type": "SIMPLE",
                  "description": "Cancels the order after payment compensation.",
                  "inputParameters": {
                    "orderId": "${workflow.input.orderId}",
                    "reason": "CONFIRMAR_PEDIDO_FALHOU",
                    "correlationId": "${workflow.input.correlationId}"
                  },
                  "retryCount": 2,
                  "retryDelaySeconds": 2,
                  "timeoutSeconds": 30
                },
                {
                  "name": "publicar_pedido_cancelado",
                  "taskReferenceName": "publicar_pedido_cancelado_apos_compensacao",
                  "type": "SIMPLE",
                  "description": "Publishes an order cancellation event through the outbox.",
                  "inputParameters": {
                    "orderId": "${workflow.input.orderId}",
                    "eventType": "PedidoCancelado",
                    "correlationId": "${workflow.input.correlationId}"
                  },
                  "retryCount": 5,
                  "retryDelaySeconds": 10,
                  "timeoutSeconds": 60
                }
              ]
            },
            "defaultCase": [
              {
                "name": "enviar_para_DLQ",
                "taskReferenceName": "enviar_para_DLQ_confirmacao_desconhecida",
                "type": "SIMPLE",
                "description": "Isolates the workflow for inspection when confirmation has no reliable outcome.",
                "inputParameters": {
                  "orderId": "${workflow.input.orderId}",
                  "reason": "CONFIRMACAO_DESCONHECIDA",
                  "correlationId": "${workflow.input.correlationId}"
                },
                "retryCount": 0,
                "timeoutSeconds": 15
              }
            ]
          }
        ],
        "DESCONHECIDO": [
          {
            "name": "consultar_o_gateway_de_pagamento",
            "taskReferenceName": "consultar_o_gateway_de_pagamento",
            "type": "SIMPLE",
            "description": "Queries the gateway when the payment outcome is unknown.",
            "inputParameters": {
              "orderId": "${workflow.input.orderId}",
              "paymentReference": "${autorizar_pagamento.output.paymentReference}",
              "correlationId": "${workflow.input.correlationId}"
            },
            "retryCount": 5,
            "retryDelaySeconds": 30,
            "timeoutSeconds": 60
          },
          {
            "name": "decidir_resultado_gateway",
            "taskReferenceName": "decidir_resultado_gateway",
            "type": "SWITCH",
            "description": "Resumes the flow based on the gateway lookup.",
            "evaluatorType": "value-param",
            "expression": "gatewayPaymentStatus",
            "inputParameters": {
              "gatewayPaymentStatus": "${consultar_o_gateway_de_pagamento.output.status}"
            },
            "decisionCases": {
              "CONFIRMADO": [
                {
                  "name": "reservar_estoque",
                  "taskReferenceName": "reservar_estoque_apos_verificacao",
                  "type": "SIMPLE",
                  "description": "Reserves inventory after the gateway confirms a pending payment.",
                  "inputParameters": {
                    "orderId": "${workflow.input.orderId}",
                    "cartId": "${workflow.input.cartId}",
                    "correlationId": "${workflow.input.correlationId}"
                  },
                  "retryCount": 3,
                  "retryDelaySeconds": 3,
                  "timeoutSeconds": 30
                },
                {
                  "name": "confirmar_pedido",
                  "taskReferenceName": "confirmar_pedido_apos_verificacao",
                  "type": "SIMPLE",
                  "description": "Confirms the order after payment verification.",
                  "inputParameters": {
                    "orderId": "${workflow.input.orderId}",
                    "correlationId": "${workflow.input.correlationId}"
                  },
                  "retryCount": 2,
                  "retryDelaySeconds": 2,
                  "timeoutSeconds": 30
                },
                {
                  "name": "publicar_pedido_confirmado",
                  "taskReferenceName": "publicar_pedido_confirmado_apos_verificacao",
                  "type": "SIMPLE",
                  "description": "Publishes confirmation after the gateway lookup.",
                  "inputParameters": {
                    "orderId": "${workflow.input.orderId}",
                    "eventType": "PedidoConfirmado",
                    "correlationId": "${workflow.input.correlationId}"
                  },
                  "retryCount": 5,
                  "retryDelaySeconds": 10,
                  "timeoutSeconds": 60
                }
              ],
              "CANCELADO": [
                {
                  "name": "cancelar_pedido",
                  "taskReferenceName": "cancelar_pedido_pagamento_cancelado",
                  "type": "SIMPLE",
                  "description": "Cancels the order when the gateway reports a canceled payment.",
                  "inputParameters": {
                    "orderId": "${workflow.input.orderId}",
                    "reason": "PAGAMENTO_CANCELADO",
                    "correlationId": "${workflow.input.correlationId}"
                  },
                  "retryCount": 2,
                  "retryDelaySeconds": 2,
                  "timeoutSeconds": 30
                }
              ]
            },
            "defaultCase": [
              {
                "name": "enviar_para_DLQ",
                "taskReferenceName": "enviar_para_DLQ_pagamento_desconhecido",
                "type": "SIMPLE",
                "description": "Routes an unresolved payment to the operational queue.",
                "inputParameters": {
                  "orderId": "${workflow.input.orderId}",
                  "reason": "PAGAMENTO_DESCONHECIDO",
                  "correlationId": "${workflow.input.correlationId}"
                },
                "retryCount": 0,
                "timeoutSeconds": 15
              }
            ]
          }
        ],
        "FALHOU": [
          {
            "name": "cancelar_pedido",
            "taskReferenceName": "cancelar_pedido_pagamento_falhou",
            "type": "SIMPLE",
            "description": "Cancels the order when payment authorization returns a known failure.",
            "inputParameters": {
              "orderId": "${workflow.input.orderId}",
              "reason": "PAGAMENTO_FALHOU",
              "correlationId": "${workflow.input.correlationId}"
            },
            "retryCount": 2,
            "retryDelaySeconds": 2,
            "timeoutSeconds": 30
          },
          {
            "name": "publicar_pedido_cancelado",
            "taskReferenceName": "publicar_pedido_cancelado_pagamento_falhou",
            "type": "SIMPLE",
            "description": "Publishes cancellation when payment fails.",
            "inputParameters": {
              "orderId": "${workflow.input.orderId}",
              "eventType": "PedidoCancelado",
              "correlationId": "${workflow.input.correlationId}"
            },
            "retryCount": 5,
            "retryDelaySeconds": 10,
            "timeoutSeconds": 60
          }
        ]
      },
      "defaultCase": [
        {
          "name": "enviar_para_DLQ",
          "taskReferenceName": "enviar_para_DLQ_resultado_pagamento_invalido",
          "type": "SIMPLE",
          "description": "Isolates workflows with an unexpected payment outcome.",
          "inputParameters": {
            "orderId": "${workflow.input.orderId}",
            "reason": "RESULTADO_PAGAMENTO_INVALIDO",
            "correlationId": "${workflow.input.correlationId}"
          },
          "retryCount": 0,
          "timeoutSeconds": 15
        }
      ]
    }
  ],
  "outputParameters": {
    "orderId": "${workflow.input.orderId}",
    "correlationId": "${workflow.input.correlationId}",
    "documentationOnly": true
  }
}
